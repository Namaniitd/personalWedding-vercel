# Next.js frontend and browser-facing BFF only. Never put DATABASE_URL,
# invitation/entry-pass peppers in this process.

# Vercel Production: exact API project production origin, without a slash.
# Only HTTPS on a single-label *.vercel.app hostname is accepted on Vercel.
# BACKEND_URL=https://your-wedding-api.vercel.app
# Local development uses the existing API server instead:
BACKEND_URL=http://127.0.0.1:4000

# The same random 32+ character value must also be set in api/.env.local or
# both Vercel projects. Generate with: openssl rand -hex 32
BACKEND_SERVICE_TOKEN=

# Frontend-only coordinator sign-in and signed-cookie credentials. Generate
# each independently; each password must be at least 16 printable characters.
# The bride password must differ from the groom password.
COORDINATOR_GROOM_PASSWORD=
COORDINATOR_BRIDE_PASSWORD=
COORDINATOR_SESSION_SECRET=

# Required on Vercel Production. Uppercase, unpadded Base32 (20–64 bytes).
# Enroll this secret privately in an authenticator: SHA1, 6 digits, 30 seconds.
# Leave empty locally for password-only sign-in; never use NEXT_PUBLIC_.
COORDINATOR_GROOM_TOTP_SECRET=
COORDINATOR_BRIDE_TOTP_SECRET=

# Existing deployments can keep these groom-only fallback variables instead
# of the corresponding GROOM variables. Never reuse them for the bride team.
# COORDINATOR_PASSWORD=
# COORDINATOR_TOTP_SECRET=

# Production: exact canonical WEB project's HTTPS origin, without a slash.
# Local development can omit this; the built Podman stack explicitly uses
# http://127.0.0.1:3000 or http://127.0.0.1:3001 with LOCAL_STACK_MODE=1.
PUBLIC_APP_ORIGIN=
# Only for the existing local Podman setup. Do not set on Vercel.
LOCAL_STACK_MODE=
