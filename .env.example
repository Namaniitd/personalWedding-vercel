# Copy to .env in the repository root for `podman compose`.
# This file contains no real values. Generate a fresh value for each field.
# Keep POSTGRES_PASSWORD URL-safe (hex is recommended), because Compose also
# inserts it into the API's PostgreSQL connection URL.
# Example generation: openssl rand -hex 32
POSTGRES_PASSWORD=
DATABASE_INVITATION_TOKEN_PEPPER=
DATABASE_ENTRY_PASS_TOKEN_PEPPER=
BACKEND_SERVICE_TOKEN=
COORDINATOR_SESSION_SECRET=

# At least 16 printable characters; use a separate random value from the
# service token and session secret.
COORDINATOR_PASSWORD=

# Optional personal frontend port: compose.yml defaults to 3000.
# Use 3002 if 3000 is occupied; 3001 is reserved for disposable smoke tests.
# Both services use this public app port. No other frontend ports are supported.
# LOCAL_WEB_PORT=3002

# Optional, written by scripts/prepare-local-build.mjs when this network
# requires a trusted local CA. Used only by the local Compose files.
# LOCAL_NODE_IMAGE=localhost/shaadi-node-local-ca:<generated-fingerprint>
