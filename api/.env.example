# API environment only. Vercel serves it over HTTPS and requires the shared
# service token for all /v1/* routes. Keep database credentials and peppers
# out of the Next.js frontend. Do not set VERCEL; Vercel supplies it.
# Generate a random 32+ character token and use the same value in web.
BACKEND_SERVICE_TOKEN=

# Choose one complete guest data adapter. Direct PostgreSQL powers both
# invitations and the coordinator. On Neon, use the runtime role's pooled
# connection URL (hostname containing -pooler) with sslmode=verify-full.
# Keep the rest of Neon's connection options; never disable TLS verification.
DATABASE_URL=
DATABASE_INVITATION_TOKEN_PEPPER=
DATABASE_ENTRY_PASS_TOKEN_PEPPER=

# Hosted Supabase powers guest invitation/RSVP only. Set all four values
# together instead of DATABASE_URL and its two peppers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INVITATION_TOKEN_PEPPER=
ENTRY_PASS_TOKEN_PEPPER=

# Production: exact canonical HTTPS origin, without a trailing slash.
# Built Podman images may use only loopback port 3000 or 3001 with
# LOCAL_STACK_MODE=1 and a PostgreSQL URL whose host is exactly db.
PUBLIC_APP_ORIGIN=
LOCAL_STACK_MODE=

# Privileged schema migration connection, using Neon's direct/unpooled host.
# These are local operator script values, never Vercel runtime variables.
# Never use the owner/admin role as DATABASE_URL.
DATABASE_SCHEMA_URL=
DATABASE_SCHEMA_APPLY_TARGET=
DATABASE_SCHEMA_APPLY_CONFIRMATION=
# Existing non-admin login role to receive reviewed API grants via psql.
DATABASE_RUNTIME_ROLE=

# Optional operator-side import script output URL. It is not a runtime URL.
INVITATION_BASE_URL=
