{
  "name": "shaadi-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file=.env.local --import tsx --watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:apply": "node scripts/apply-database-schema.mjs",
    "content:apply": "node --env-file=.env.local scripts/apply-wedding-content.mjs",
    "import:households": "node scripts/import-households.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "@vercel/functions": "3.9.11",
    "csv-parse": "7.0.2",
    "pg": "8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/pg": "8.15.6",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
