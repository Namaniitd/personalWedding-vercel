{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "installCommand": "npx --yes pnpm@11.13.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@11.13.0 typecheck",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/healthz", "destination": "/api/index?__shaadi_route=/healthz" },
    { "source": "/readyz", "destination": "/api/index?__shaadi_route=/readyz" },
    { "source": "/v1/:path*", "destination": "/api/index?__shaadi_route=/v1/:path*" }
  ]
}
